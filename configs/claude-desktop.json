{
  "mcpServers": {
    "maxstat": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.38",
        "https://maxstat.ru/api/mcp",
        "--header",
        "X-API-Token:${MAXSTAT_API_TOKEN}"
      ],
      "env": {
        "MAXSTAT_API_TOKEN": "<API_TOKEN>"
      }
    }
  }
}
