{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fbmdata/maxstat-mcp",
  "title": "MaxStat MCP",
  "description": "Search MAX channels and posts. Compare audience, views and reactions; find forwards.",
  "version": "1.2.4",
  "websiteUrl": "https://maxstat.ru/promo/mcp",
  "repository": {
    "url": "https://github.com/fbmdata/maxstat-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://maxstat.ru/api/mcp",
      "headers": [
        {
          "name": "X-API-Token",
          "description": "MaxStat API token",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
