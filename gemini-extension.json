{
  "name": "maxstat-mcp",
  "version": "1.2.4",
  "description": "Поиск каналов и публикаций MAX, аудитория, просмотры и реакции / Search MAX channels and posts; compare audience, views and reactions.",
  "settings": [
    {
      "name": "MaxStat API token",
      "description": "Создайте API-токен в кабинете: https://maxstat.ru/dashboard/api",
      "envVar": "MAXSTAT_API_TOKEN",
      "sensitive": true
    }
  ],
  "mcpServers": {
    "maxstat": {
      "httpUrl": "https://maxstat.ru/api/mcp",
      "headers": {
        "X-API-Token": "${MAXSTAT_API_TOKEN}"
      }
    }
  },
  "contextFileName": "GEMINI.md"
}
